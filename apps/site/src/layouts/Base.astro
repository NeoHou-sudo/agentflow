---
import '../styles/global.css';
import { SITE, SHELL, abs } from '../lib/site';
import { shellCssVars } from '../lib/shell';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  type?: string;
  published?: string;
}

const { title, description, path, jsonLd = [], type = 'website', published } = Astro.props;
const canonical = abs(Astro, path);
// 必须是 PNG：Twitter / Facebook / 微信 都不认 SVG 的 og:image。
// 由 scripts/build-og.mjs 生成（1200×630）。
const ogImage = abs(Astro, '/og.png');
const ogImageAlt = `${SITE.name} — ${SITE.tagline}`;
const fullTitle =
  path === '/'
    ? [SITE.name, SITE.cn].filter(Boolean).join(' · ') + ` — ${SITE.tagline}`
    : `${title} | ${SITE.name}`;

// 壳注入：一个 <html> 上的 data-shell + 一组 CSS 变量，就是整个「壳」。
// 组件里不再出现任何品牌色或品牌名。
// 壳还可以指定等宽字体（品牌手册里的「数字 / 代码」位），没有就沿用默认栈。
const monoVar = SHELL.fonts?.mono ? ` --mono: ${SHELL.fonts.mono};` : '';
const shellVars = `${shellCssVars(SHELL)}${monoVar} color-scheme: ${SHELL.scheme};`;

// 站点图标跟着壳走。壳带 markSvg 的（品牌壳）直接用真 Logo ——
// 手册纪律：不许改色、不许拆件，所以不重绘、不加底色，原样当图标。
// 其余壳用字符拼一个，省得再维护一堆静态文件。
const faviconSvg = SHELL.markSvg
  ? SHELL.markSvg
  : `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">` +
    `<rect width="64" height="64" rx="${SHELL.scheme === 'light' ? 10 : 14}" fill="${SHELL.tokens['bg']}"/>` +
    `<rect x="3" y="3" width="58" height="58" rx="${SHELL.scheme === 'light' ? 8 : 12}" fill="${SHELL.tokens.brand}"/>` +
    `<text x="32" y="33" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" ` +
    `font-size="${SHELL.mark.length > 1 ? 26 : 34}" font-weight="800" fill="#fff" ` +
    `text-anchor="middle" dominant-baseline="central">${SHELL.mark}</text></svg>`;
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

const NAV = [
  { href: '/workflows/', label: '全部工作流' },
  { href: '/categories/ecommerce/', label: '电商' },
  { href: '/categories/content/', label: '内容' },
  { href: '/categories/investment/', label: '投资' },
];
---

<!doctype html>
<html lang="zh-CN" data-shell={SHELL.id} style={shellVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="theme-color" content={SHELL.tokens['bg']} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {published && <meta property="article:modified_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- 让 AI 爬虫直接找到给模型看的索引：/llms.txt -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM index" />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          {SHELL.markSvg ? (
            <span class="logo" set:html={SHELL.markSvg} />
          ) : (
            <span class={SHELL.markMono ? 'mark' : 'emoji'}>{SHELL.mark}</span>
          )}
          <span>{SITE.name} {SITE.cn && <small>{SITE.cn}</small>}</span>
        </a>
        <nav class="nav">
          {NAV.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={SITE.repo} target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap row">
        {/* 页脚不放标记 —— 页眉已经有 Logo 了，再放一个字符兜底在这儿
            会读成「港 AgentFlow」这种奇怪的东西 */}
        <span>{SITE.name}</span>
        <span>MIT License</span>
        <span class="sp">
          <a href="/llms.txt">llms.txt</a> · <a href="/sitemap.xml">sitemap</a> ·
          <a href={SITE.repo} target="_blank" rel="noopener">GitHub</a>
        </span>
      </div>
    </footer>

    <div id="toast" role="status" aria-live="polite"></div>

    <script>
      // 全站共用的两个小工具：复制、toast 提示
      const toastEl = document.getElementById('toast') as HTMLDivElement | null;
      let toastTimer: number | undefined;
      (window as any).afToast = (msg: string) => {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.add('show');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 1900);
      };

      (window as any).afCopy = async (text: string, okMsg = '已复制') => {
        const toast = (window as any).afToast as (m: string) => void;
        try {
          await navigator.clipboard.writeText(text);
          toast(okMsg);
        } catch {
          // 非 https / 无剪贴板权限时退回到老办法
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          toast(okMsg);
        }
      };

      // 声明式复制按钮：<button data-copy="#selector">
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement)?.closest('[data-copy]') as HTMLElement | null;
        if (!btn) return;
        const sel = btn.getAttribute('data-copy')!;
        const src = document.querySelector(sel);
        if (!src) return;
        const text = (src as HTMLTextAreaElement).value ?? src.textContent ?? '';
        void (window as any).afCopy(text, btn.getAttribute('data-copy-msg') ?? '已复制');
      });
    </script>
  </body>
</html>
